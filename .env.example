# Backend (FastAPI)
DATABASE_URL=sqlite:///./nigraan.db          # production: postgresql://user:pass@host:5432/nigraan
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true                                # exposes /demo/reset, /demo/load-week and the demo toolbar
ALLOWED_ORIGIN=http://localhost:3000          # comma-separated; set to your Vercel URL in production
GEMINI_API_KEY=                               # optional; without it uploads use PDF text + regex (labelled)
GEMINI_MODEL=gemini-2.5-flash
HASH_SALT=change-me                           # salt for CNIC/IBAN hashes (must match the seeded data)

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
